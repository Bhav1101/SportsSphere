              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/match/fetchAll",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "match",
                "fetchAll"
              ]
            },
            "description": "Admin view: Fetches all matches including deleted ones. Requires admin authentication."
          },
          "response": []
        },
        {
          "name": "Fetch Single Match (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
