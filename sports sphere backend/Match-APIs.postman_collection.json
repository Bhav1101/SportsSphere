  "item": [
    {
      "name": "Public Match Endpoints",
      "description": "Public endpoints for fetching matches (no admin auth required)",
      "item": [
        {
          "name": "Fetch All Upcoming Matches",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://localhost:3000/api/user/match/fetchAll",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "user",
                "match",
                "fetchAll"
              ]
            },
            "description": "Fetches all upcoming matches. Automatically marks expired matches as completed before returning results."
          },
          "response": []
        },
        {
          "name": "Fetch Single Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"_id\": \"match_id_here\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/user/match/fetchSingle",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "user",
                "match",
                "fetchSingle"
              ]
            },
            "description": "Fetches details for a single upcoming match. Returns match info with populated sport, venue, and team data."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Match Management",
      "description": "Admin endpoints for managing matches (requires authentication + admin role)",
      "item": [
        {
          "name": "Add New Match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sportId\": \"sport_id_here\",\n  \"venueId\": \"venue_id_here\",\n  \"matchName\": \"Cricket Match 2026\",\n  \"matchDate\": \"2026-05-15T18:00:00Z\",\n  \"matchTime\": \"6:00 PM\",\n  \"city\": \"New Delhi\",\n  \"description\": \"Exciting cricket match between two teams\",\n  \"team1Id\": \"team1_id_here\",\n  \"team2Id\": \"team2_id_here\",\n  \"totalSeats\": 100,\n  \"availableSeats\": 100,\n  \"ticketPrice\": 500,\n  \"maxApplications\": 10,\n  \"prizePool\": {\n    \"winner\": 50000,\n    \"runnerUp\": 30000\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/match/add",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "match",
                "add"
              ]
            },
            "description": "Creates a new match. Supports banner image upload. Requires admin authentication."
          },
          "response": []
        },
        {
          "name": "Fetch All Matches (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
